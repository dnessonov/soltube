{
  "name": "@soltube/solana-video",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "import": "./dist/writer.js",
      "require": "./dist/writer.cjs"
    },
    "./writerClient": {
      "types": "./dist/writerClient.d.ts",
      "import": "./dist/writerClient.js",
      "require": "./dist/writerClient.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/writerClient.ts src/writer.ts src/react.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/writerClient.ts src/writer.ts src/react.ts --format cjs,esm --dts --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@solana/client": "^1.7.0",
    "@solana/web3.js": "^1.98.4",
    "borsh": "^2.0.0",
    "brotli-compress": "^2.2.2",
    "fzstd": "^0.1.1",
    "js-crc": "^0.3.1"
  }
}
